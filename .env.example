# Use a dedicated application role; never commit real credentials.
DATABASE_URL=postgresql://flooring_app:change-me@localhost:5432/flooring
INGEST_BATCH_SIZE=1000

# Server-side embedding configuration. Never expose this key in browser code.
OPENAI_API_KEY=replace-with-a-server-side-secret
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_TEXT_CHARS=12000

# Structured customer-requirement extraction.
REQUIREMENT_EXTRACTION_MODEL=gpt-5-mini

# Single-domain setting used by the local flooring-chat CLI.
CLIENT_DOMAIN=https://exampleflooring.com

# Hosted API registry containing domains, origins, titles, and widget positions.
SITE_CONFIG_PATH=config/sites.json

# Production controls. Use SITE_CONFIG_JSON from a secret instead of a path on ECS.
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
API_DOCS_ENABLED=true
MAX_REQUEST_BODY_BYTES=16384
SESSION_TTL_SECONDS=86400
MAX_IN_MEMORY_SESSIONS=10000
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=30
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
LANGGRAPH_STRICT_MSGPACK=true
